#include <stdio.h>
#include <pthread.h>
#include <semaphore.h>

sem_t empty, full;
int buffer = 0;

void* producer(void* arg)
{
    sem_wait(&empty);   // wait for empty buffer
    buffer++;
    printf("Producer produced item. Buffer = %d\n", buffer);
    sem_post(&full);    // signal full buffer
    pthread_exit(NULL);
}

void* consumer(void* arg)
{
    sem_wait(&full);    // wait for full buffer
    buffer--;
    printf("Consumer consumed item. Buffer = %d\n", buffer);
    sem_post(&empty);   // signal empty buffer
    pthread_exit(NULL);
}

int main()
{
    pthread_t p, c;

    sem_init(&empty, 0, 1);  // buffer empty
    sem_init(&full, 0, 0);   // buffer full = 0

    pthread_create(&p, NULL, producer, NULL);
    pthread_create(&c, NULL, consumer, NULL);

    pthread_join(p, NULL);
    pthread_join(c, NULL);

    return 0;
}
