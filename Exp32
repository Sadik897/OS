#include <stdio.h>

int main()
{
    int frames, pages, i, j, faults = 0;
    int frame[10], page[20];
    int front = 0;

    printf("Enter number of frames: ");
    scanf("%d", &frames);

    printf("Enter number of pages: ");
    scanf("%d", &pages);

    printf("Enter page reference string:\n");
    for(i = 0; i < pages; i++)
        scanf("%d", &page[i]);

    // initialize frames
    for(i = 0; i < frames; i++)
        frame[i] = -1;

    for(i = 0; i < pages; i++)
    {
        int found = 0;

        // check if page is already in frame
        for(j = 0; j < frames; j++)
        {
            if(frame[j] == page[i])
            {
                found = 1;
                break;
            }
        }

        // page fault
        if(!found)
        {
            frame[front] = page[i];
            front = (front + 1) % frames;
            faults++;
        }

        // display frames
        printf("Frames: ");
        for(j = 0; j < frames; j++)
            printf("%d ", frame[j]);
        printf("\n");
    }

    printf("\nTotal Page Faults = %d\n", faults);

    return 0;
}
